       'value'=>function ($data) {
               return Html::a(Html::encode($data['Content']),'update?id='.$data['ID'],['data-pjax'=>"0"]);
        },
                                'filterInputOptions' => [
                'class'       => 'form-control',
                'placeholder' => 'Enter Advertisement Title..'
             ],
    ], 
     [
    'attribute' => 'FromDate',
    'filter'=>false,
],
                     [
    'attribute' => 'ToDate',
    'filter'=>false,
],
                [
                'header' => 'Status',
                'attribute' => 'Status',
          'value' => function ($data) {
                        return \backend\models\Advertisements::getStatusValue($data['Status']);
                    },
                'filter'=>Html::activeDropDownList($searchModel, 'Status',array(""=>"All","1"=>"Active","2"=>"Inactive"),['class'=>'form-control','options' => [ "" => ['selected ' => true]]]),
            ],
