                }
              });
            }
        });
      }
   }
});

/************************** Subscriber Uploded Video *****************************/
/**
* When admin can reject any video then call this funciton.
*/
function getReject(id,memberid) {
  //alert("hiii");
     $("#spinnerLoader").show();
      var videoid = id;
      var mid = memberid;
      var datastring  = 'SID='+videoid+'&MemberID='+mid;
        $.ajax({
               type : 'POST',
               url  :  '../member/uploadvideoreject',
               data : datastring,
                success : function(msg) {
                      
                            location.reload();
                            $("#spinnerLoader").hide();
                           }
          });
   }