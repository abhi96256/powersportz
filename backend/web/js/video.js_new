          FB.getLoginStatus(function(response) {
            console.log(response);
          if (response.status === 'connected') {
               console.log('Logged in.');
          }
          else {
                FB.login(function(response){
                    if(response.authResponse == null){
                        $($this).removeAttr('checked');
                    }
                }, {scope: 'publish_actions'});
          }
        });
      }else if($(this).val() == 3){
        console.log("Google+");
        gapi.auth.authorize({client_id: clientId, scope: scopes, immediate: false},  function (authResult) {
          if (authResult && !authResult.error) {
              console.log("login !!!");
           } else {
              $($this).removeAttr('checked');
          }
      });
      }else if($(this).val() == 1){
        console.log("Linkedin");
        IN.UI.Authorize().place()
        IN.Event.on(IN, "auth", function(){ });
      }else if($(this).val() == 2){
        $($this).removeAttr('checked');
       /* console.log("Twitter");
        var twitter_connect = new TwitterConnect('https://api.twitter.com/oauth/authorize?oauth_token=4417738454-xrS1tIg6u8CxhyqiP7QnRHBigPIHbSrLAMbErtN');
        twitter_connect.exec();*/
//        twitter_btn.on('click', function(e) {
  //        e.preventDefault();
//          twitter_connect.exec();
    //    });
        // TwitterConnect();
        twitterOauthPopup();
        /*$.oauthpopup({
              path: "https://api.twitter.com/oauth/authorize?oauth_token=Z6eEdO8MOmk394WozF5oKyuAv855l4Mlqo7hhlSLik",
              callback: function(ev)
              {
                  console.log(ev);
                  //do callback stuff
              }
          });*/
       /* $.oauthpopup({
            path: website_url+'video/logintwitter',
            success : function(){
              
            }
        });*/
    /* twttr.events.bind(
        'click',
        function (ev) {
          console.log(ev);
        }
      );*/
      }else if($(this).val() == 3){
          gapi.auth.authorize({client_id: clientId, scope: scopes, immediate: true}, 
              function(authresult){
                if (authResult && !authResult.error) {
                   console.log("login !!!");
                    } else {
                    console.log("Not login");
                  }
              });
      }else if($(this).val() == 4){
          console.log("Pintrest");
          PDK.login({scope : 'read_public, write_public'}, function(session) {
            if (!session) {
              alert('The user chose not to grant permissions or closed the pop-up');
            } else {
              console.log('Thanks for authenticating. Getting your information...');
              PDK.me(function(response) {
                if (!response || response.error) {
